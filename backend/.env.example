# ==============================================================================
# GEMINI API CONFIGURATION
# ==============================================================================
# Get your free API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# LLM SETTINGS
# ==============================================================================
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.3
MAX_CONTEXT_CHUNKS=5

# ==============================================================================
# RSS FEED CONFIGURATION
# ==============================================================================
# Comma-separated list of RSS feed URLs
RSS_FEEDS=http://feeds.bbci.co.uk/news/rss.xml,http://feeds.reuters.com/reuters/topNews,https://news.ycombinator.com/rss,https://techcrunch.com/feed/

# Poll interval in seconds (60 = every minute)
RSS_POLL_INTERVAL=60

# ==============================================================================
# PATHWAY SERVER CONFIGURATION
# ==============================================================================
PATHWAY_HOST=0.0.0.0
PATHWAY_PORT=8000

# Autocommit duration in milliseconds (1000 = 1 second latency)
AUTOCOMMIT_DURATION_MS=1000

# ==============================================================================
# ALERT CONFIGURATION
# ==============================================================================
# Keywords to monitor (comma-separated)
ALERT_KEYWORDS=Tesla,Bitcoin,Fed,inflation,crash,China,Apple,Google,Microsoft,Amazon,Nvidia,Meta

# Number of mentions required to trigger alert
ALERT_THRESHOLD=3

# ==============================================================================
# SENTIMENT ANALYSIS
# ==============================================================================
# Rolling window for sentiment calculation (in minutes)
SENTIMENT_WINDOW_MINUTES=10
