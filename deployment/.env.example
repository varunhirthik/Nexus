# ⚠️ SECURITY WARNING ⚠️
# This is a TEMPLATE file for Cloud Run deployment.
# DO NOT commit actual API keys to git!
#
# For Cloud Run, use Secret Manager instead:
#   gcloud secrets create GOOGLE_API_KEY --data-file=-
#   gcloud secrets create NEWS_API_KEY --data-file=-
#   gcloud secrets create GNEWS_API_KEY --data-file=-
#
# See: cloudrun/setup-secrets.sh for automated setup

# ============================================================================
# Google Gemini API Key
# ============================================================================
# In Cloud Run, this will be injected from Secret Manager
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# News API Configuration
# ============================================================================
# In Cloud Run, these will be injected from Secret Manager
NEWSAPI_KEY=your_newsapi_key_here
GNEWS_KEY=your_gnews_api_key_here

NEWS_POLL_INTERVAL=600
NEWS_CATEGORIES=general,business,technology,science,health,entertainment
NEWS_KEYWORDS=Tesla,Bitcoin,cryptocurrency,AI,artificial intelligence,stock market,Fed,inflation,tech,startup,merger
NEWS_ENABLED=true

# ============================================================================
# RSS Feed Configuration (Legacy/Fallback)
# ============================================================================
RSS_POLL_INTERVAL=60
RSS_FEEDS=

# ============================================================================
# Pathway Configuration
# ============================================================================
PATHWAY_HOST=0.0.0.0
PATHWAY_PORT=8000
AUTOCOMMIT_DURATION_MS=1000

# ============================================================================
# Alert Configuration
# ============================================================================
ALERT_KEYWORDS=Tesla,Bitcoin,Fed,inflation,crash,China
ALERT_THRESHOLD=3

# ============================================================================
# LLM Configuration
# ============================================================================
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.3
MAX_CONTEXT_CHUNKS=5

# ============================================================================
# Sentiment Analysis
# ============================================================================
SENTIMENT_WINDOW_MINUTES=10

# ============================================================================
# CORS Configuration (IMPORTANT FOR PRODUCTION)
# ============================================================================
# Set this to your actual frontend Cloud Run URL
# Example: https://nexus-frontend-xxxxx.a.run.app
ALLOWED_ORIGINS=https://your-frontend-url.a.run.app

# ============================================================================
# Rate Limiting Configuration
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_QUERY_PER_MINUTE=10
RATE_LIMIT_NEWS_PER_MINUTE=30
