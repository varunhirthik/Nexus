# Google Gemini API Key (Get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# News API Configuration (Real-time news fetching)
NEWSAPI_KEY=your_newsapi_key_here
GNEWS_KEY=your_gnews_key_here
NEWS_POLL_INTERVAL=600
NEWS_CATEGORIES=general,business,technology,science,health,entertainment
NEWS_KEYWORDS=Tesla,Bitcoin,cryptocurrency,AI,artificial intelligence,stock market,Fed,inflation
NEWS_ENABLED=true

# RSS Feed Configuration (Legacy/Fallback)
RSS_POLL_INTERVAL=60
RSS_FEEDS=http://feeds.bbci.co.uk/news/rss.xml,http://feeds.reuters.com/reuters/topNews,https://news.ycombinator.com/rss

# Pathway Configuration
PATHWAY_HOST=0.0.0.0
PATHWAY_PORT=8000
AUTOCOMMIT_DURATION_MS=1000

# Alert Configuration
ALERT_KEYWORDS=Tesla,Bitcoin,Fed,inflation,crash,China
ALERT_THRESHOLD=3

# LLM Configuration
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.3
MAX_CONTEXT_CHUNKS=5

# Sentiment Analysis
SENTIMENT_WINDOW_MINUTES=10
